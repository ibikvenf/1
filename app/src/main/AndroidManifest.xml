<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：仅用于更新病毒库 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 通知：扫描进度 / 威胁告警 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 查杀已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 存储扫描：经典权限（Android 12 及以下） -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />
    <!-- Android 10+ 全盘文件访问（杀毒软件核心能力） -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 13+ 媒体权限（未授予全盘访问时降级可用） -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- 开机自启实时防护 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 用户可主动为实时防护关闭电池限制 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".AegisApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AegisAV"
        tools:ignore="AllowBackup">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.ScanActivity" android:exported="false" />
        <activity android:name=".ui.ResultsActivity" android:exported="false" />
        <activity android:name=".ui.AppsActivity" android:exported="false" />
        <activity android:name=".ui.HistoryActivity" android:exported="false" />
        <activity android:name=".ui.UpdateActivity" android:exported="false" />
        <activity android:name=".ui.QuarantineActivity" android:exported="false" />
        <activity android:name=".ui.SettingsActivity" android:exported="false" />

        <!-- 分享查杀：接收其他应用分享来的文件/文本 -->
        <activity
            android:name=".ui.ShareScanActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AegisAV.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>
        </activity>

        <!-- 扫描前台服务 -->
        <service
            android:name=".service.ScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 实时防护服务 -->
        <service
            android:name=".service.RealtimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 新装/更新应用自动查杀（PACKAGE_ADDED 属系统白名单广播，清单注册有效） -->
        <receiver
            android:name=".receiver.InstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 开机 / 应用升级后恢复实时防护 -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
